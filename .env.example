WAKETRACE_API_KEY=
WAKETRACE_API_BASE_URL=https://api.example.com/v1/chat/completions
WAKETRACE_MODEL=your-model-name
WAKETRACE_ADMIN_TOKEN=replace-with-a-long-random-token
# Optional read-only token for the bundled Web interface
WAKETRACE_WEB_TOKEN=replace-with-a-different-long-random-token
# Token used by MCP clients. Keep it different from the two tokens above.
WAKETRACE_MCP_TOKEN=replace-with-a-third-long-random-token
# Read tools are always available after MCP authentication. Writes are opt-in.
WAKETRACE_MCP_ALLOW_WRITE=false
# Experimental: let an official client complete a scheduled wake through MCP.
WAKETRACE_MCP_ALLOW_WAKE=false
# Add the public reverse-proxy host here when MCP is reached remotely.
WAKETRACE_MCP_ALLOWED_HOSTS=127.0.0.1,127.0.0.1:*,localhost,localhost:*
# Disable this when ChatGPT or Claude supplies the wake opportunity itself.
WAKETRACE_SCHEDULER_ENABLED=true
WAKETRACE_DB_PATH=./data/waketrace.db
WAKETRACE_WEB_DIST_PATH=./web/dist/client
# Optional, comma-separated origins for a separately hosted Web interface
WAKETRACE_WEB_ORIGINS=

WAKETRACE_COMPANION_NAME=Companion
WAKETRACE_USER_NAME=User
WAKETRACE_TIMEZONE=UTC

WAKETRACE_MIN_INTERVAL_MINUTES=30
WAKETRACE_MAX_INTERVAL_MINUTES=120
WAKETRACE_NIGHT_MIN_INTERVAL_MINUTES=120
WAKETRACE_MAX_WAKES_PER_DAY=15
WAKETRACE_QUIET_HOURS_START=23
WAKETRACE_QUIET_HOURS_END=7

# Optional Web Push
WAKETRACE_VAPID_PRIVATE_KEY=
WAKETRACE_VAPID_CLAIMS_EMAIL=mailto:admin@example.com
